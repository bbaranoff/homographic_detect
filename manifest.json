{
  "manifest_version": 3,
  "name": "IDN watch",
  "version": "1.1",
  "permissions": ["tabs", "theme", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["warn.html"], "matches": ["<all_urls>"] }],
  "action": { "default_title": "IDN watch" },
  "background": { "scripts": ["bg.js"] }
}
